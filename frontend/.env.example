# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (VAPID) ──────────────────────────────────────
# Enables browser push notifications when the app/tab is closed.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Then paste the values below into your .env.local.
#   - The PUBLIC key is safe to expose to the browser (NEXT_PUBLIC_).
#   - The PRIVATE key is a SECRET — never commit it or expose it to the client.
#   - VAPID_SUBJECT is a contact URL/mailto the push service can reach you at.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@mitaoe.ac.in

# ── AI (optional, provider-agnostic) ──────────────────────
# Powers the "Campus Assistant" FAQ widget and channel AI summaries.
# Set NEXT_PUBLIC_AI_ENABLED=true to SHOW the AI UI, and provide the key for your
# chosen provider below. With no key the features stay hidden and nothing breaks.
#   AI_PROVIDER = anthropic | openai | gemini   (default: anthropic)
NEXT_PUBLIC_AI_ENABLED=false
AI_PROVIDER=anthropic
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ── Calendar & QR attendance ──────────────────────────────
# No keys required: .ics download, "Add to Google Calendar" links, and event
# check-in QR codes all work out of the box. (Full two-way Google/Outlook sync
# would need OAuth credentials — not required for the built-in features.)
